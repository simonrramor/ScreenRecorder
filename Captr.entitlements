<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Captr intentionally runs WITHOUT the App Sandbox. It shells out to
	  external tools (adb, scrcpy, the pymobiledevice3 venv, ffplay,
	  osascript) via Process, which the sandbox would block. Distribution is
	  via Developer ID + notarization rather than the Mac App Store, so the
	  sandbox is not required. Hardened runtime is enabled (see project.yml).
	-->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
